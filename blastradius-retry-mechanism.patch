diff --git a/blastradius-validator/src/main/java/io/github/baokhang83/blastradius/validator/build/TransientBuildFailureDetector.java b/blastradius-validator/src/main/java/io/github/baokhang83/blastradius/validator/build/TransientBuildFailureDetector.java
